# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development            # development | production | test
DATABASE_URL=postgresql+psycopg://prospect:prospect_dev@localhost:5432/prospect
# Fine-grained personal access token with read-only public repository access.
# Without it GitHub allows only 60 requests/hour for your IP.
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ANALYSIS_WINDOW_DAYS=365
CACHE_TTL_MINUTES=30
MAX_PAGES_PER_ENDPOINT=5
PR_DETAIL_SAMPLE=15
# Random string used to hash commit authors that have no GitHub account.
AUTHOR_HASH_SALT=change-me
# Postgres container credentials (docker compose)
POSTGRES_USER=prospect
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prospect
# Frontend (build time). Leave empty when frontend is served behind the same origin.
VITE_API_BASE_URL=
