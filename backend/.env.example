# Optional: a GitHub personal access token (no scopes needed for public
# repos) raises the GitHub API rate limit from 60 to 5,000 requests/hour.
# Copy this file to .env and fill it in, or leave it unset to run
# unauthenticated.
GITHUB_TOKEN=

# Optional overrides (defaults shown):
# DATABASE_PATH=./prospect.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
